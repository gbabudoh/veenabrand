// Prisma schema for Veena — run `npx prisma migrate dev` after setting DATABASE_URL
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}



model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String?   @unique
  name          String?
  passwordHash  String?
  role          String    @default("USER") // "USER" | "ADMIN" | "SUPERADMIN"
  createdAt     DateTime  @default(now())
  orders        Order[]
  adjustmentRequests AdjustmentRequest[]
  bespokeRequests    BespokeRequest[]
  cart          Cart?
}

// Navigation + merchandising taxonomy. Self-referencing so a category can nest
// one or more levels deep (e.g. Women > Dresses > Maxi). Managed from /admin/categories.
model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  gender      String?    // "WOMEN" | "MEN" | null = shown under both
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  active      Boolean    @default(true)  // inactive hides it everywhere on the storefront
  showInNav   Boolean    @default(true)  // hide from the navbar without deactivating it
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products    Product[]

  @@index([parentId, sortOrder])
  @@index([gender, active])
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  fabricCare  String
  shippingReturnsNote String
  gender      String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  priceMinor  Int        // store price in kobo (NGN minor unit) to avoid float errors
  currency    String     @default("NGN")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  media       ProductMedia[]
  colors      ProductColor[]
  variants    ProductVariant[]
  reviews     Review[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([gender, categoryId])
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String
  url       String     // real asset URL (image or video) — placeholder in design
  label     String?    // e.g. "Front", "On Model", "Fabric Close-up"
  sortOrder Int        @default(0)
}

model ProductColor {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   // e.g. "Emerald"
  hex       String   // e.g. "#1F5C42"
  sortOrder Int      @default(0)
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String   // "XS".."XL"
  colorName String
  stock     Int      @default(0)

  @@unique([productId, size, colorName])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  rating    Int      // 1-5
  text      String
  createdAt DateTime @default(now())
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id])
  guestToken String?   @unique // for anonymous carts, stored in an httpOnly cookie
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  size      String
  colorName String
  quantity  Int      @default(1)

  @@unique([cartId, productId, size, colorName])
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique // e.g. VN-20481
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  email           String
  items           OrderItem[]
  subtotalMinor   Int
  deliveryFeeMinor Int
  totalMinor      Int
  currency        String         @default("NGN")
  deliveryMethod  String
  shippingAddress String?        // null for pickup, stored as stringified JSON
  pickupStoreId   String?
  paymentMethod   String
  status          String         @default("PENDING_PAYMENT")
  createdAt       DateTime       @default(now())
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  size      String
  colorName String
  quantity  Int
  unitPriceMinor Int
}

// "Request Adjustment" flow from the PDP
model AdjustmentRequest {
  id           String         @id @default(cuid())
  userId       String?
  user         User?          @relation(fields: [userId], references: [id])
  orderItemId  String?        // optional link to a purchased item
  productId    String
  adjustmentType String       // e.g. "Hem length", "Sleeve length"
  note         String
  status       String  @default("SUBMITTED")
  createdAt    DateTime       @default(now())
}

// "Request Bespoke" flow from the PDP / bespoke teaser
model BespokeRequest {
  id           String        @id @default(cuid())
  userId       String?
  user         User?         @relation(fields: [userId], references: [id])
  referenceProductId String? // product this was inspired by, optional
  fabricPreference String
  timeline     String
  measurements String         // { chest, waist, hip, height, ... } in cm, stored as stringified JSON
  note         String?
  status       String        @default("SUBMITTED")
  quoteMinor   Int?
  depositPaid  Boolean       @default(false)
  createdAt    DateTime      @default(now())
}

// "Try It On" submissions — measurement-based fit prediction
model FittingRequest {
  id           String   @id @default(cuid())
  productId    String
  method       String   // "photo" | "measurements" | "model"
  measurements String?
  predictedSize String?
  createdAt    DateTime @default(now())
}

model Store {
  id       String  @id @default(cuid())
  name     String
  address  String
  city     String  @default("Lagos")
  isPickupAvailable Boolean @default(true)
}

model HomepageConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // Stringified JSON
  updatedAt DateTime @updatedAt
}

model DiscountCode {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model SystemSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // Stringified JSON
  updatedAt DateTime @updatedAt
}

// One-to-one video consultation between a customer and the atelier (LiveKit).
// The customer joins via /consult/<room>; the room name is the unguessable link.
model Consultation {
  id               String    @id @default(cuid())
  room             String    @unique
  customerName     String
  customerEmail    String?
  customerPhone    String?
  topic            String    @default("Bespoke consultation")
  notes            String?
  bespokeRequestId String?
  status           String    @default("SCHEDULED") // SCHEDULED | LIVE | ENDED | CANCELLED
  scheduledAt      DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// One-to-many runway / live-shopping broadcast (LiveKit). Viewers watch at /live/<slug>.
model LiveShow {
  id          String    @id @default(cuid())
  slug        String    @unique
  room        String    @unique
  title       String
  description String?
  posterImage String?
  featured    Boolean   @default(true) // show the "Live now" bar on the storefront while live
  status      String    @default("SCHEDULED") // SCHEDULED | LIVE | ENDED
  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  peakViewers Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
