# Postgres connection string. Locally: `docker run -e POSTGRES_PASSWORD=veena -e POSTGRES_DB=veena -p 5432:5432 postgres:16`
DATABASE_URL="postgresql://postgres:veena@localhost:5432/veena?schema=public"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Payments (choose provider(s) — not wired in this scaffold, add SDK + keys when ready)
PAYSTACK_SECRET_KEY=""
STRIPE_SECRET_KEY=""

# Optional: live "Ask Veena" AI assistant instead of scripted FAQ
#ANTHROPIC_API_KEY=""
