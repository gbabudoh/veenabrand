# Postgres connection string. Locally: `docker run -e POSTGRES_PASSWORD=veena -e POSTGRES_DB=veena -p 5432:5432 postgres:16`
DATABASE_URL="postgresql://postgres:veena@localhost:5432/veena?schema=public"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Payments (choose provider(s) — not wired in this scaffold, add SDK + keys when ready)
PAYSTACK_SECRET_KEY=""
STRIPE_SECRET_KEY=""

# Optional: live "Ask Veena" AI assistant instead of scripted FAQ
#ANTHROPIC_API_KEY=""

# MinIO / S3 — media uploads (admin)
S3_ENDPOINT="https://s3.example.com"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="veenafashion"
S3_FORCE_PATH_STYLE="true"
# Optional: public URL of the bucket root (objects are served at <this>/<key>), e.g. a CDN.
# Leave empty to use S3_ENDPOINT/S3_BUCKET.
S3_PUBLIC_URL=""

# imgproxy — resized/optimised images. KEY and SALT are hex strings from the imgproxy server config.
IMGPROXY_URL="https://img.example.com"
IMGPROXY_KEY=""
IMGPROXY_SALT=""

# LiveKit — live video sessions
LIVEKIT_URL="wss://livekit.example.com"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
